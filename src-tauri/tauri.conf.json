{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Werkbank",
  "version": "1.0.0",
  "identifier": "de.viergutz.werkbank",
  "build": {
    "frontendDist": "stub",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/": "frontend/"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF-Dokument",
        "description": "PDF-Dokument",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "category": "Productivity",
    "publisher": "Malte Viergutz",
    "copyright": "© 2026 Malte Viergutz · AGPL-3.0",
    "license": "AGPL-3.0-only",
    "shortDescription": "PDF-Werkzeugkasten",
    "longDescription": "Werkbank liest, bearbeitet, wandelt und schützt PDF-Dateien – vollständig lokal, ohne Cloud.",
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["German", "English"] }
    }
  }
}
